# Rust build output
/target
**/*.rs.bk
*.pdb

# cbindgen-generated FFI header (regenerated on build)
crates/resilum-ffi/resilum.h

# Keep Cargo.lock committed (workspace has binaries)

# Signing / secrets — never commit
keys/
*.pem
*.key
secrets.*
.codeberg-token

# Everything under the deploy/config bind mount is per-node runtime,
# except .example templates and the reference resilumd.yaml.
deploy/config/**
!deploy/config/**/
!deploy/config/*.example
!deploy/config/**/*.example
!deploy/config/resilumd.yaml

# Local dev compose override
deploy/compose.override.yaml

docs/__check/
