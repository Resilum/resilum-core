# Rust build output
/target
**/*.rs.bk
*.pdb

# cbindgen-generated FFI header (regenerated on build)
crates/resilum-ffi/resilum.h

# Keep Cargo.lock committed (workspace has binaries)

# Signing / secrets — never commit
keys/
*.pem
*.key
secrets.*
.codeberg-token

# Node runtime state and generated per-node configs
deploy/config/state/
deploy/config/yggdrasil.conf
deploy/config/torrc
deploy/config/tor/
deploy/config/i2pd.conf
deploy/config/i2pd-tunnels.conf
deploy/config/i2p/
