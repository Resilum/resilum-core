---
# Bind-mounted at /config in the container; the entrypoint reads
# /config/resilumd.yaml on startup.

instance_name: resilum

# Identity and RNS state persist in `state/` next to this file. Set a path to
# put them elsewhere.
# storage_path: /var/lib/resilum

# Join the global mesh through the built-in public + Yggdrasil anchors and a
# discoverable public listener on [::]:4242. Set to false for an isolated node
# configured purely via `listen`/`bootstrap`.
default_anchors: true

# Reach the mesh over the plain internet: public anchors, LAN, and an inbound
# listener. false leaves only the overlays (tor/ygg/iroh/covert) — the node's
# address is never exposed, but it is isolated until one of them is up.
# plain_ip: true

discover_interfaces: true

# Address peers should dial back on, when it differs from `listen` (NAT,
# port-forward). Announced verbatim to the mesh.
# reachable_on: "203.0.113.10"

# listen: "[::]:4242"

# Extra always-on anchors on top of `default_anchors`.
# bootstrap:
#   - anchor.example:4343

# Transport-discovery plugins: each attaches discovered peers over its
# transport and (when it can determine our own reachable endpoint) announces
# ours for others to attach. `iroh` is the exception: it resolves peers but
# only announces this node when given `publish: true`, so that a leaf does not
# beacon its address by default.
discovery:
  - service: yggdrasil
  - service: tor
  - service: i2p
  - service: iroh
  #   publish: true

# Canonical rngit-mirror repo names this node hosts, announced in the mesh so
# `resilumd mirrors find <repo>` on any peer prints live
# rns://<hash>/mirrors/<repo> URLs without out-of-band coordination. Publisher
# fills these via `rngit mirror <upstream> rns://self/mirrors/<name>` in the
# sidecar container.
advertised_mirrors:
  - REPLACE-WITH-A-REPO-NAME-YOU-MIRROR
  # - another-repo-name
rngit_destination_file: /config/rngit/state/destination

# Optional native I2P interface (needs a local i2pd with SAM on 127.0.0.1:7656).
# i2p:
#   connectable: true          # be reachable inbound over I2P
#   peers:
#     - somebase32.b32.i2p

# Be an exit for mesh peers. With the tor/i2p providers below, the traffic
# leaves the Tor or I2P network, not this host's address. `- service:
# socks-egress` instead sends peers' traffic out of this host's own public
# address: this node is what appears in the destination's logs, and what any
# complaint about that traffic is addressed to.
egress:
  - service: tor
    target: 127.0.0.1:9050
  # - service: i2p             # only lets peers reach .i2p sites, not clearnet
  #   target: 127.0.0.1:4447
  # - service: socks-egress
  #   exit_country: DE
  #   allow_private: false     # `true` lets peers reach this host's loopback
  #                            # services and its LAN — only for a node whose
  #                            # peers are all trusted

# `services` is which provider kinds to look for, not an order of preference —
# every discovered one is ranked by measured latency. `use_own: smart` skips
# your own socks-egress, which would put your own traffic back on your own
# address, but allows your own tor/i2p.
ingress:
  services: [socks-egress, tor]
  # `none`, or drop the line, to find and rank exits without binding a local
  # proxy — a loopback proxy is reachable by everything else on the host.
  listen_tcp: 127.0.0.1:${RESILUM_SOCKS_PORT:-10808}
  # smart | "true" | "false" — the last two need the quotes: unquoted they are
  # YAML booleans and the config fails to load. Anything else means smart.
  use_own: smart
  allow_countries: []
  deny_countries: []

# Reach peers by tunnelling inside ICMP echo. This node announces the
# addresses peers should aim at, and dials the ones their announces name.
# Listening needs raw sockets (CAP_NET_RAW, granted in compose.yaml); without
# them the node still dials out, it just cannot be dialled. `covert: []` turns
# it off; omitting the key keeps the default on.
covert:
  - carrier: icmp
    mtu: 1400
    addresses: []              # empty: detect this host's public addresses
    dial_local_networks: false # only dial peers at addresses the public
                               # internet routes. Set true for peers on your
                               # own LAN — it also lets any peer aim this
                               # node at a host inside your network, so turn
                               # it on only among nodes you run yourself.

# Messaging. Registers this node's LXMF delivery destination so peers can send
# it messages, and is what the Nostr bridge below carries them over — without
# it the bridge has no way to reach a device and refuses to start.
lxmf: {}

# Carry direct messages between this mesh and the ordinary Nostr network. The
# device does every piece of cryptography; this node is a postman with a
# websocket and can read nothing it carries.
nostr:
  upstreams:
    - wss://relay.damus.io
  publish: false               # advertise as a bridge in the discovery announce
  allow_npubs: []              # empty: anyone on the mesh may use this bridge,
                               # to subscribe and to publish. List npubs to make
                               # it personal — then only they may do either, and
                               # publishing requires having subscribed first.
  legacy_dm: true              # also accept inbound kind 4, which names its
                               # sender in the clear and invites spam
  publish_kinds:               # kinds this bridge will send OUT to the relays.
    - 1059                     # Independent of `legacy_dm`, which only decides
    - 4                        # what is asked for inbound: leaving 4 here with
    - 10050                    # `legacy_dm: false` still publishes kind 4.
                               # 10050 is the DM inbox relay list, which a
                               # device signs itself so senders outside the
                               # mesh learn where to write to it.
  retention: 7d                # how long an undelivered event and an
                               # unrefreshed subscription are kept
